{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "sentinel-service values",
  "type": "object",
  "required": ["image", "service", "podSecurityContext", "securityContext", "resources"],
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1 },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "not": { "const": "latest" } },
        "digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "targetPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "app": {
      "type": "object",
      "properties": {
        "logLevel": { "enum": ["DEBUG", "INFO", "WARNING", "ERROR"] },
        "warmupSeconds": { "type": "number", "minimum": 0 },
        "faultInjection": { "type": "boolean" }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "required": ["runAsNonRoot"],
      "properties": { "runAsNonRoot": { "const": true } }
    },
    "securityContext": {
      "type": "object",
      "required": ["allowPrivilegeEscalation", "readOnlyRootFilesystem"],
      "properties": {
        "allowPrivilegeEscalation": { "const": false },
        "readOnlyRootFilesystem": { "const": true },
        "privileged": { "const": false }
      }
    },
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "requests": { "type": "object", "required": ["cpu", "memory"] },
        "limits": { "type": "object", "required": ["memory"] }
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    }
  }
}
